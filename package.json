{
  "name": "unabot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The one-click market maker for memes.",
  "license": "UNLICENSED",
  "bin": {
    "unabot": "./bin/unabot.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./hosted": {
      "types": "./src/hosted-bundle.ts",
      "require": "./vendor/hosted-cjs/index.cjs",
      "default": "./vendor/hosted-cjs/index.cjs"
    }
  },
  "scripts": {
    "bundle:hosted": "node scripts/bundle-hosted.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-cli.mjs && node scripts/bundle-hosted.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "unabot": "node ./bin/unabot.mjs",
    "mcp": "node ./bin/unabot.mjs mcp",
    "ci": "bash scripts/ci.sh",
    "dev": "next dev",
    "build:web": "node scripts/bundle-hosted.mjs && next build",
    "build:eve": "node scripts/bundle-hosted.mjs && eve build",
    "eve:dev": "node scripts/bundle-hosted.mjs && eve dev",
    "eve:deploy": "eve deploy --project unabot",
    "curate:index": "bun src/curator/cli.ts",
    "registry:calldata": "bun scripts/registry-calldata.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.14",
    "@meteora-ag/zap-sdk": "1.3.2",
    "@modelcontextprotocol/sdk": "1.17.5",
    "@privy-io/react-auth": "^3.38.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana-program/memo": "0.8.0",
    "@solana-program/system": "0.8.0",
    "@solana-program/token": "0.6.0",
    "@solana/kit": "3.0.3",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@uniswap/sdk-core": "^7.7.2",
    "@uniswap/v3-sdk": "^3.25.2",
    "ai": "^7.0.84",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "commander": "^12.1.0",
    "eve": "^0.47.3",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unabot-hosted-cjs": "file:./vendor/hosted-cjs",
    "viem": "^2.31.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
