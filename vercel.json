{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/bundle-hosted.mjs && next build",
  "installCommand": "npx -y bun@1.4.0 install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/pools",
      "schedule": "*/5 * * * *"
    }
  ]
}
