# Public Base RPC. Override for a dedicated provider in production.
BASE_RPC_URL=https://mainnet.base.org

# Public Robinhood chain RPC. Override for a dedicated provider in production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional archive-capable RPC used only by the cached Pool activity scan.
ROBINHOOD_ACTIVITY_RPC_URL=

# Solana mainnet RPCs. Use a dedicated provider in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Optional. When set, write paths use Uniswap LP + Trading APIs.
# Headers sent: x-api-key, Content-Type: application/json, Accept: application/json
UNISWAP_API_KEY=

# Hot wallet for --live broadcasts. Never commit this file. Dry-run is the default.
UNABOT_PRIVATE_KEY=

# Optional override. Product fees always go here unless you change this.
UNABOT_TREASURY=0x2520B4BA71D2a026803cce0e5C72eDa4a20B0C42

# Deferred onchain-registry option. Leave blank while the version-controlled catalog is authoritative.
UNA_INDEX_REGISTRY_ADDRESS=

# Public Solana fee recipient for withdraw and reinvest fees. Required for those actions.
UNABOT_SOLANA_TREASURY=

# Optional USD/ETH reference used only for skip math when no pool quote is available.
UNABOT_ETH_USD=3000

# Optional. Telegram surface: unabot telegram. Create via @BotFather. Never commit the token.
TELEGRAM_BOT_TOKEN=

# Optional. Admit anonymous eve HTTP in production. Default fail-closed.
EVE_ALLOW_ANON=
# Vercel AI Gateway for eve, or link the Vercel project to use OIDC.
AI_GATEWAY_API_KEY=

# Optional. Keeper AlertSink webhook (stdout JSON always). Never commit a secret URL.
UNABOT_ALERT_WEBHOOK=
