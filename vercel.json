{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "redirect",
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "status": 410
    },
    {
      "src": "/.*",
      "methods": [
        "GET",
        "HEAD"
      ],
      "status": 308,
      "headers": {
        "Location": "https://github.com/galleonlabs/boomkin"
      }
    },
    {
      "src": "/.*",
      "status": 410
    }
  ]
}
